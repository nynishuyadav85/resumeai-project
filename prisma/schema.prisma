generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Analysis {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())
  resumeText     String   @db.Text
  jobDescription String   @db.Text
  aiResponse     String   @db.Text
}